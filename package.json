{
  "name": "svelte-doctor",
  "version": "0.2.8",
  "description": "Diagnose and fix performance, correctness, and architecture issues in your Svelte codebase",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "diagnostics",
    "linter",
    "performance",
    "runes",
    "migration",
    "codemod",
    "cli",
    "static-analysis",
    "code-quality",
    "typescript",
    "security",
    "refactoring",
    "ai",
    "analyzer",
    "vite",
    "javascript"
  ],
  "license": "Apache-2.0",
  "author": "Pimatis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pimatis/svelte-doctor.git"
  },
  "homepage": "https://github.com/Pimatis/svelte-doctor",
  "bugs": {
    "url": "https://github.com/Pimatis/svelte-doctor/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.10",
  "bin": {
    "svelte-doctor": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "rm -rf dist && NODE_ENV=production tsdown && rm -f dist/*.map && node -e \"const fs=require('node:fs'); for (const file of fs.readdirSync('dist')) { if (!file.endsWith('.mjs')) continue; const path='dist/' + file; const source=fs.readFileSync(path,'utf8').replace(/^\\/\\/\\# sourceMappingURL=.*$/gm,'').replace(/\\n{3,}/g,'\\n\\n'); fs.writeFileSync(path, source, 'utf8'); }\"",
    "check": "tsc --noEmit",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test test"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "knip": "^6.14.1",
    "ora": "^9.4.0",
    "picocolors": "^1.1.1",
    "svelte": "^5.55.7",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "tsdown": "^0.21.10",
    "@types/node": "^25.8.0"
  }
}
